# AI Provider: gemini | openai | ollama | demo
AI_PROVIDER=demo

# Google Gemini (recommended free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Optional Production PostgreSQL (pgvector) & Redis (uses built-in SQLite + memory cache if empty)
DATABASE_URL=
REDIS_URL=

# Server
PORT=8000
